{
  "name": "dsh-continue-button",
  "description": "DSH Web UI plugin: adds a Continue (play) button next to the send icon that sends a 'continue' message; hidden while the session is running or is a blank new session",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "typecheck": "node --check lib/client.js && node --check lib/index.js && echo ok"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "continue",
    "web-ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1 || ^0.2.0-rc.1"
  }
}
